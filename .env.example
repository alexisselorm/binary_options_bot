APP_ID=your_deriv_app_id
API_TOKEN=your_deriv_api_token
ASSET=R_100
EXPIRY=5
STAKE=10
MAX_STAKE=10
TIMEFRAME=1
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
BACKTEST=false


#Model
MODEL_TYPE=hybrid        # [lstm, xgboost, hybrid, rule]
MODEL_PATH_LSTM=models/lstm_model.h5
MODEL_PATH_XGB=models/xgb_model.json
MODEL_PATH_RL=models/ppo_agent.zip
SIGNAL_THRESHOLD=0.65
SEQUENCE_LENGTH=100

# Risk Management
MAX_CONSECUTIVE_LOSSES=3
TRADE_RISK_PERCENT=1.0       # % of balance per trade
MIN_BALANCE=50               # Stop trading below this balance
MARTINGALE_MODE=off          # [off, martingale, anti-martingale]


# Backtesting
HISTORICAL_DATA_PATH=data/R_100_1m.csv
SAVE_TRADE_HISTORY=true
TRADE_HISTORY_PATH=logs/trade_history.csv

# ─────────────────────────────────────────────────────────────────────
# External Signal Settings (MT4/MT5 Bridge)
# ─────────────────────────────────────────────────────────────────────
# Enable/disable external signal processing from MT4/MT5
ENABLE_EXTERNAL_SIGNALS=false

# Directory containing signal files (relative to bot root)
EXTERNAL_SIGNAL_DIR=signals

# Name of the signal file
EXTERNAL_SIGNAL_FILE=signals.json

# Interval in seconds to check for new signals
EXTERNAL_SIGNAL_INTERVAL=5

# Maximum age of signals in seconds (older signals are rejected)
EXTERNAL_SIGNAL_MAX_AGE_SECONDS=60

# Minimum confidence threshold (0.0 = accept all, 1.0 = only highest)
EXTERNAL_SIGNAL_CONFIDENCE_THRESHOLD=0.0

# Symbol mapping from MT to Deriv symbols
# Format: "MT_SYMBOL:DERIV_SYMBOL,MT_SYMBOL2:DERIV_SYMBOL2"
EXTERNAL_SYMBOL_MAP=EURUSD:frxEURUSD,GBPUSD:frxGBPUSD,USDJPY:frxUSDJPY

# LLM Orchestration Agent
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.0
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_DRY_RUN=true
AGENT_ALLOWED_SYMBOLS=R_100
AGENT_MAX_CONCURRENT_POSITIONS=1
AGENT_MAX_STAKE=10
AGENT_SCHEMA_RETRIES=2
AGENT_MAX_TOOL_STEPS=6
