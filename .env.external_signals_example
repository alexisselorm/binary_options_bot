# ─────────────────────────────────────────────────────────────────────
# External Signals Configuration Example (MT4/MT5 Bridge)
# ─────────────────────────────────────────────────────────────────────
# Copy this file to 'env' (without the dot) and fill in your credentials
# This configuration enables the bot to receive signals from MT4/MT5

# ─────────────────────────────────────────────────────────────────────
# 🔐 Deriv API Credentials
# ─────────────────────────────────────────────────────────────────────
APP_ID=your_app_id_here
API_TOKEN=your_api_token_here
LLM_API_TOKEN=your_llm_api_token_here

# ─────────────────────────────────────────────────────────────────────
# 📈 Trading Settings (defaults, overridden by signal mapping)
# ─────────────────────────────────────────────────────────────────────
ASSET=R_100
EXPIRY=1
STAKE=1.0
MAX_STAKE=10.0
TIMEFRAME=1

# ─────────────────────────────────────────────────────────────────────
# 📡 Notification Settings (Leave empty if not using)
# ─────────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────
# 🧠 AI Strategy Settings (not used when external signals enabled)
# ─────────────────────────────────────────────────────────────────────
MODEL_TYPE=rule
MODEL_PATH_LSTM=models/lstm_model.keras
MODEL_PATH_XGB=models/xgb_model.json
MODEL_PATH_RL=models/ppo_agent.zip
SIGNAL_THRESHOLD=0.6
SEQUENCE_LENGTH=100

# ─────────────────────────────────────────────────────────────────────
# ⚖️ Risk Management (applies to external signals too)
# ─────────────────────────────────────────────────────────────────────
MAX_CONSECUTIVE_LOSSES=5
TRADE_RISK_PERCENT=1.0
MIN_BALANCE=10.0
MARTINGALE_MODE=off

# ─────────────────────────────────────────────────────────────────────
# 🧪 Backtesting
# ─────────────────────────────────────────────────────────────────────
HISTORICAL_DATA_PATH=data/historical_candles.csv
SAVE_TRADE_HISTORY=true
TRADE_HISTORY_PATH=logs/trade_history.csv

# ─────────────────────────────────────────────────────────────────────
# 📊 External Signal Settings (MT4/MT5 Bridge)
# ─────────────────────────────────────────────────────────────────────

# Enable external signals from MT4/MT5
ENABLE_EXTERNAL_SIGNALS=true

# Interval in seconds to check for new signals
EXTERNAL_SIGNAL_INTERVAL=5

# Directory where MT5 EA writes signals
# On Windows with MT5: C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\XXXXXXXX\MQL5\Files
# On same machine (relative path): signals
EXTERNAL_SIGNAL_DIR=signals

# Name of the signal file
EXTERNAL_SIGNAL_FILE=signals.json

# Maximum age of signals in seconds (older signals are rejected)
# Increase if you experience delays between MT5 and Python
EXTERNAL_SIGNAL_MAX_AGE_SECONDS=60

# Minimum confidence threshold (0.0 to 1.0)
# Set to 0.0 to accept all signals regardless of confidence
# Set to 0.7 to only accept signals with confidence >= 70%
EXTERNAL_SIGNAL_CONFIDENCE_THRESHOLD=0.0

# Symbol mapping from MT4/MT5 symbols to Deriv symbols
# Format: "MT_SYMBOL:DERIV_SYMBOL,MT_SYMBOL2:DERIV_SYMBOL2"
# Common mappings:
#   Forex: EURUSD->frxEURUSD, GBPUSD->frxGBPUSD, USDJPY->frxUSDJPY
#   Synthetics: R_100->R_100, 1HZ10V->1HZ10V
EXTERNAL_SYMBOL_MAP=EURUSD:frxEURUSD,GBPUSD:frxGBPUSD,USDJPY:frxUSDJPY,AUDUSD:frxAUDUSD

# Alternative: JSON format for complex mappings
# EXTERNAL_SYMBOL_MAP={"EURUSD":"frxEURUSD","GBPUSD":"frxGBPUSD","USDJPY":"frxUSDJPY"}

# ─────────────────────────────────────────────────────────────────────
# 📝 Usage Notes
# ─────────────────────────────────────────────────────────────────────
# 1. Compile MT5_Signal_Indicator.mq5 and attach to chart
# 2. Compile MT5_Signal_EA.mq5 and attach to same chart
# 3. Enable "Allow Algo Trading" in MT5 (Alt+A)
# 4. Set EXTERNAL_SIGNAL_DIR to MT5's Files folder path
# 5. Run the bot: python main.py
# 6. Monitor logs for signal processing
#
# See MT4_MT5_BRIDGE.md for detailed setup instructions
